<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Game Booster: kayan panel (diğer uygulamaların üzerinde göster) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Game Booster: PUBG'nin açıldığını algılamak için kullanım erişimi (kullanıcı Ayarlar'dan verir) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Game Booster: oyun sırasında bildirimleri sessize alma (Rahatsız Etme erişimi, kullanıcı Ayarlar'dan verir) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Paket görünürlüğü (Android 11+): başlatılabilir uygulamalar + desteklenen PUBG paketleri.
         Yeni bölgesel sürüm eklenirse GameBooster.kt > PUBG_PACKAGES ve buraya paket adı eklenir. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.tencent.ig" />
        <package android:name="com.pubg.krmobile" />
        <package android:name="com.vng.pubgmobile" />
        <package android:name="com.rekoo.pubgm" />
        <package android:name="com.pubg.imobile" />
        <package android:name="com.tencent.tmgp.pubgmhd" />
        <package android:name="com.tencent.iglite" />
    </queries>

    <application
    android:allowBackup="true"
    android:label="Suffer Shadow"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher"
    android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SufferVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".GameBoosterService"
            android:exported="false" />
    </application>
</manifest>

